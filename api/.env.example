# Copy this file to `.env` and fill in real values. `.env` is gitignored; this file is committed.

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Database — put your real connection string in .env, NOT here.
# Local example:  mongodb://127.0.0.1:27017/swappa
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/swappa
MONGO_URI=mongodb://127.0.0.1:27017/swappa

# Auth (JWT)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AI (Gemini) — backend only
GEMINI_API_KEY=

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=

# Google Maps Platform — server key only (Places API + Geocoding API enabled,
# restricted to this server's IP). Never ship this key in the Flutter app.
GOOGLE_MAPS_SERVER_KEY=

# Salts the deterministic location-fuzzing offset shown to free-tier viewers.
# Has a dev default; set a real random value in production.
LOCATION_FUZZ_SALT=

# Email — priority: Resend → Mailjet → SMTP → console.
# NOTE: Render (and many PaaS hosts) block outbound raw SMTP entirely, so
# SMTP_* below only works for local dev / hosts that allow it. Use Resend or
# Mailjet (both HTTPS APIs) when deployed to Render.
MAIL_FROM="SWAPPA <verify@yourdomain.com>"

# Primary (HTTPS) — Resend. Get an API key from resend.com/api-keys once
# you've verified a domain there (Domains tab — needs DNS access; once the
# domain shows "Verified" you can send from any address @that domain).
RESEND_API_KEY=

# (Alternative, HTTPS) Mailjet — used if RESEND_API_KEY isn't set. Get keys
# from app.mailjet.com/account/apikeys. MAIL_FROM's address must be verified
# as a sender at app.mailjet.com/account/sender (single-address email
# confirmation — no DNS/domain access needed, unlike Resend's domain
# verification).
MAILJET_API_KEY=
MAILJET_API_SECRET=

# (Alternative — local dev only) Generic SMTP. Render blocks outbound raw
# SMTP entirely, so this only works locally / on hosts that allow it.
# Gmail SMTP setup:
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account → Security → App passwords → create one (16 chars).
#   3. SMTP_USER = your full gmail address; SMTP_PASS = that app password
#      (NOT your normal password). MAIL_FROM should be the same gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraddress@gmail.com
SMTP_PASS=

# Firebase Cloud Messaging (service account)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Realtime/RTC provider (Agora/LiveKit) — for remote sessions (US4)
RTC_APP_ID=
RTC_APP_CERTIFICATE=
