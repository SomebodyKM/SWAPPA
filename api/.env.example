# Copy this file to `.env` and fill in real values. `.env` is gitignored; this file is committed.

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Database — put your real connection string in .env, NOT here.
# Local example:  mongodb://127.0.0.1:27017/swappa
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/swappa
MONGO_URI=mongodb://127.0.0.1:27017/swappa

# Auth (JWT)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AI (Gemini) — backend only
GEMINI_API_KEY=

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=

# Firebase Cloud Messaging (service account)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Realtime/RTC provider (Agora/LiveKit) — for remote sessions (US4)
RTC_APP_ID=
RTC_APP_CERTIFICATE=
